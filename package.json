{
  "name": "round-table",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "vitest run",
    "check:deps": "node scripts/check-deps.ts",
    "check": "pnpm check:deps && pnpm typecheck && pnpm test",
    "e2e": "pnpm --filter @round-table/app build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@round-table/agent": "workspace:*",
    "@round-table/hub": "workspace:*",
    "@round-table/protocol": "workspace:*",
    "@round-table/testkit": "workspace:*",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
